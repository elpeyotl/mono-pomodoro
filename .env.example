# Kopiere diese Datei zu .env und fülle die Werte aus.
# In Cloud-Sessions erledigt das scripts/cloud-setup.sh.

# Postgres (Neon). Auf Vercel setzt die Neon-Integration DATABASE_URL automatisch,
# in Vorschauen zeigt sie auf einen eigenen Neon-Branch (preview/<branch>).
DATABASE_URL=postgres://mono:mono@localhost:5432/mono

# Better Auth
# Secret: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me
# Öffentliche URL der App (Produktion: https://monopomodoro.app o.ä.)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
# Redirect-URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailversand für Bestätigung und Passwort-Reset (https://resend.com)
# Ohne Key werden die Links lokal in der Konsole ausgegeben.
# In Vercel-Vorschauen (VERCEL_ENV=preview) wird nie gesendet.
RESEND_API_KEY=
MAIL_FROM=Mono <noreply@monopomodoro.app>

# Site URL (Meta-Tags)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Nur für den einmaligen Umzug (scripts/migrate-from-supabase.ts):
# Supabase Dashboard > Connect > Session pooler (Postgres-URL inkl. Passwort)
# SUPABASE_DB_URL=
